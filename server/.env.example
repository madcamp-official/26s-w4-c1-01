# 네이버쇼핑 검색 API (즉시 발급·합법, grounding·구매 딥링크 소스)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# LLM 검색쿼리 생성/큐레이션 (선택 — 없으면 원문 쿼리 그대로)
ANTHROPIC_API_KEY=

# camp-4 3090 이미지 서버 (선택 — 없으면 클라이언트 목업이 최종)
SD_SERVER_URL=

# 자동 배치 LLM — Gemini(Google AI Studio 무료 키). 있으면 Anthropic보다 우선.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash   # 일일 한도(모델당 20회) 소진 시 체인이 3.5→3.5-lite→3.1-lite로 자동 폴백

# 포토리얼 렌더 — camp-3 Blender 서비스(SSH 터널 8610). run.sh가 자동 설정.
RENDER_SERVER_URL=http://127.0.0.1:8610

# ── 소셜 로그인(OAuth) — 각 플랫폼 개발자 콘솔에서 발급. 없으면 앱은 데모 로그인으로 폴백 ──
# 등록할 Redirect URI(공통 규칙): {AUTH_REDIRECT_BASE}/api/auth/{kakao|naver|google}/callback
AUTH_REDIRECT_BASE=http://localhost:5173
AUTH_SECRET=            # 세션 토큰 서명키 — 아무 긴 랜덤 문자열

KAKAO_CLIENT_ID=        # Kakao Developers > 앱 > REST API 키
KAKAO_CLIENT_SECRET=    # (선택) 보안 > Client Secret

NAVER_LOGIN_CLIENT_ID=      # 네이버 개발자센터 '네이버 로그인' 앱 (쇼핑검색 키와 별개!)
NAVER_LOGIN_CLIENT_SECRET=

GOOGLE_CLIENT_ID=       # Google Cloud Console > OAuth 클라이언트 ID(웹)
GOOGLE_CLIENT_SECRET=
